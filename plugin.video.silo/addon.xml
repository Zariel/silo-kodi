<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.silo" name="Silo" version="0.1.0" provider-name="silo-kodi contributors">
  <requires>
    <import addon="xbmc.python" version="3.0.1" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Browse and play media from Silo</summary>
    <description lang="en_GB">Sign in to Silo using a QR code and choose an account profile. Library browsing and playback are under development.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
